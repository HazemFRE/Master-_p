@section styles {
    <style>
        :root {
            --primary: #2c5e48;
            --primary-light: #3d7a5f;
            --secondary: #d4a017;
            --secondary-dark: #b58a14;
            --light: #f8f5f0;
            --dark: #1a2e24;
            --text: #222;
            --light-text: #6a6a6a;
            --white: #fff;
            --overlay: rgba(0, 0, 0, 0.6);
            --transition: all 0.3s ease;
        }

        body {
            font-family: 'Tajawal', sans-serif;
            color: var(--text);
            line-height: 1.7;
            overflow-x: hidden;
            margin: 0;
        }

        .container {
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 15px;
        }

            .container p {
                font-size: 1.1rem;
                margin-bottom: 12px;
                text-align: center;
            }

        /* Hero Section */
        .hero-section {
            position: relative;
            height: 100vh;
            min-height: 600px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            overflow: hidden;
        }

        .hero-background {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: url('https://images.unsplash.com/photo-1601524909164-3d6d3cbf9cf8?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80');
            background-size: cover;
            background-position: center;
            z-index: 1;
        }

        .hero-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to left, rgba(0,0,0,0.3), rgba(44,94,72,0.7));
            z-index: 2;
        }

        .hero-content {
            position: relative;
            z-index: 3;
            color: var(--white);
            max-width: 1000px;
            padding: 0 15px;
        }

        .hero-title {
            font-size: 3.2rem;
            font-weight: 700;
            line-height: 1.2;
            margin-bottom: 15px;
        }

        .title-line {
            display: block;
        }

            .title-line.accent {
                color: var(--secondary);
                margin-right: 20px;
            }

        .hero-subtitle {
            font-size: 1.2rem;
            margin-bottom: 30px;
            opacity: 0.9;
        }

        .hero-actions {
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 10px 25px;
            border-radius: 25px;
            font-weight: 600;
            text-decoration: none;
            transition: var(--transition);
            text-align: center;
        }

            .btn:focus {
                outline: 3px solid var(--secondary);
                outline-offset: 2px;
            }

        .btn-primary {
            background: var(--secondary);
            color: var(--dark);
        }

            .btn-primary:hover {
                background: var(--secondary-dark);
                transform: translateY(-3px);
                box-shadow: 0 8px 15px rgba(212, 160, 23, 0.3);
            }

        .btn-outline {
            border: 2px solid var(--white);
            color: var(--white);
        }

            .btn-outline:hover {
                background: var(--white);
                color: var(--primary);
            }

        .hero-scroll-indicator {
            position: absolute;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 3;
            animation: bounce 2s infinite;
        }

            .hero-scroll-indicator span {
                display: block;
                width: 18px;
                height: 28px;
                border: 2px solid var(--white);
                border-radius: 14px;
                position: relative;
            }

                .hero-scroll-indicator span::before {
                    content: '';
                    position: absolute;
                    top: 5px;
                    left: 50%;
                    transform: translateX(-50%);
                    width: 4px;
                    height: 7px;
                    background-color: var(--white);
                    border-radius: 2px;
                    animation: scroll 2s infinite;
                }

        /* About Section */
        .about-section {
            padding: 60px 0;
            background: var(--light);
        }

        .section-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .section-title {
            font-size: 2.2rem;
            color: var(--primary);
            margin-bottom: 12px;
            position: relative;
            display: inline-block;
        }

        .section-divider {
            width: 60px;
            height: 3px;
            background: var(--secondary);
            margin: 0 auto 15px;
        }

        .section-subtitle {
            color: var(--light-text);
            font-size: 1rem;
        }

        .section-header p {
            color: var(--light-text);
            font-size: 1rem;
        }

        .about-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            align-items: center;
        }

        .about-image {
            position: relative;
            height: 400px;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 15px 30px rgba(0,0,0,0.15);
        }

            .about-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .experience-badge {
            position: absolute;
            top: -15px;
            right: -15px;
            background: var(--secondary);
            color: var(--dark);
            padding: 10px 20px;
            border-radius: 8px;
            font-weight: 700;
            box-shadow: 0 8px 20px rgba(212, 160, 23, 0.3);
            z-index: 2;
        }

            .experience-badge span {
                font-size: 1.5rem;
                display: block;
                line-height: 1;
            }

        .highlight-text {
            font-size: 1.1rem;
            color: var(--primary);
            line-height: 1.7;
            margin-bottom: 20px;
            position: relative;
            padding-right: 15px;
        }

            .highlight-text::before {
                content: '';
                position: absolute;
                right: 0;
                top: 0;
                height: 100%;
                width: 3px;
                background-color: var(--secondary);
            }

        .about-features {
            display: grid;
            grid-template-columns: 1fr;
            gap: 15px;
        }

        .feature-card {
            display: flex;
            gap: 15px;
            padding: 15px;
            background: var(--white);
            border-radius: 8px;
            box-shadow: 0 5px 10px rgba(0, 0, 0, 0.05);
            transition: var(--transition);
        }

            .feature-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
            }

        .feature-icon {
            width: 50px;
            height: 50px;
            background: var(--light);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--secondary);
            font-size: 1.3rem;
            flex-shrink: 0;
        }

        .feature-text h3 {
            color: var(--primary);
            margin-bottom: 8px;
        }

        /* Quality Section */
        .quality-section {
            position: relative;
            padding: 60px 0;
            background: linear-gradient(rgba(44, 94, 72, 0.9), rgba(44, 94, 72, 0.9)), url('https://images.unsplash.com/photo-1601524909106-9f5d1a3fe9d8?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80') center/cover no-repeat;
            color: var(--white);
        }

        .quality-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.4);
        }

        .quality-section .section-title {
            color: var(--white);
        }

        .quality-section .section-divider {
            background: var(--secondary);
        }

        .quality-steps {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
            max-width: 1000px;
            margin: 0 auto;
        }

        .step {
            display: flex;
            gap: 15px;
            align-items: flex-start;
        }

        .step-number {
            font-size: 2.2rem;
            color: var(--secondary);
            font-weight: 700;
            opacity: 0.7;
        }

        .step-content h3 {
            font-size: 1.4rem;
            margin-bottom: 12px;
            color: var(--white);
        }

        .step-content p {
            color: rgba(255, 255, 255, 0.8);
        }

        /* Certificates Section */
        .certificates-section {
            padding: 60px 0;
            background: var(--light);
        }

        .certificates-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 25px;
            max-width: 1000px;
            margin: 0 auto;
        }

        .certificate-card {
            background: var(--white);
            border-radius: 8px;
            padding: 30px 20px;
            text-align: center;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
            transition: var(--transition);
            position: relative;
            overflow: hidden;
        }

            .certificate-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 12px 30px rgba(0, 0, 0, 0.1);
            }

        .certificate-icon {
            width: 70px;
            height: 70px;
            margin: 0 auto 15px;
            background: var(--light);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            color: var(--secondary);
        }

        .certificate-card h3 {
            color: var(--primary);
            margin: 12px 0 5px;
        }

        .certificate-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            padding: 8px;
            background: var(--secondary);
            color: var(--dark);
            font-weight: 600;
            transform: translateY(100%);
            transition: var(--transition);
        }

        .certificate-card:hover .certificate-overlay {
            transform: translateY(0);
        }

        /* Contact Section */
        .contact-section {
            display: flex;
            min-height: 400px;
        }

        .contact-content {
            flex: 1;
            padding: 50px 30px;
            background: var(--primary);
            color: var(--white);
        }

        .contact-methods {
            display: grid;
            grid-template-columns: 1fr; /* Changed to single column for vertical stacking */
            gap: 20px;
            max-width: 500px; /* Reduced max-width to keep cards centered and compact */
            margin: 0 auto;
        }

        .contact-card {
            background: rgba(255, 255, 255, 0.1);
            padding: 20px;
            border-radius: 8px;
            transition: var(--transition);
            text-align: center;
        }

            .contact-card:hover {
                background: rgba(255, 255, 255, 0.2);
                transform: translateY(-5px);
            }

        .contact-icon {
            width: 50px;
            height: 50px;
            margin: 0 auto 15px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            color: var(--secondary);
        }

        .contact-card h3 {
            margin-bottom: 12px;
        }

        .contact-card a {
            color: var(--white);
            text-decoration: none;
            transition: var(--transition);
        }

            .contact-card a:hover {
                color: var(--secondary);
            }

        .complaint-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: var(--white);
            text-decoration: none;
            transition: var(--transition);
        }

            .complaint-link:hover {
                color: var(--secondary);
            }

            .complaint-link .ml-2 {
                margin-right: 8px;
            }

        .contact-map {
            flex: 1;
            height: 400px;
        }

            .contact-map iframe {
                width: 100%;
                height: 100%;
                border: none;
            }

        /* Animations */
        keyframes bounce {
            0%, 20%, 50%, 80%, 100%

        {
            transform: translateY(0);
        }

        40% {
            transform: translateY(-20px);
        }

        60% {
            transform: translateY(-10px);
        }

        }

        keyframes scroll {
            0%

        {
            transform: translate(-50%, 0);
            opacity: 1;
        }

        100% {
            transform: translate(-50%, 10px);
            opacity: 0;
        }

        }

        /* Responsive Design */
        media (max-width: 1200px) {
            .hero-title

        {
            font-size: 2.8rem;
        }

        .about-grid {
            gap: 20px;
        }

        }

        media (max-width: 992px) {
            .hero-section

        {
            min-height: 500px;
        }

        .about-grid {
            grid-template-columns: 1fr;
        }

        .about-image {
            height: 250px;
        }

        .contact-section {
            flex-direction: column;
        }

        .contact-content {
            padding: 40px 20px;
        }

        .contact-map {
            height: 250px;
        }

        }

        media (max-width: 768px) {
            .section-title

        {
            font-size: 1.8rem;
        }

        .hero-title {
            font-size: 2.2rem;
        }

        .hero-subtitle {
            font-size: 1rem;
        }

        .hero-actions {
            flex-direction: column;
            gap: 12px;
        }

        .btn {
            width: 100%;
            max-width: 280px;
            margin: 0 auto;
        }

        .quality-steps {
            grid-template-columns: 1fr;
        }

        }

        media (max-width: 576px) {
            .experience-badge

        {
            top: -12px;
            right: -12px;
            padding: 8px 12px;
        }

        .experience-badge span {
            font-size: 1.2rem;
        }

        .feature-card {
            flex-direction: column;
            text-align: center;
        }

        .feature-icon {
            margin: 0 auto;
        }

        .hero-title {
            font-size: 1.8rem;
        }

        }
    </style>
}

<!-- Hero Section -->
